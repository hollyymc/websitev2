---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProjectObject from '../../components/ProjectObject.astro';
import Polaroid from '../../components/Polaroid.astro';
import Arrow from '../../components/Arrow.astro';
import TextRing from '../../components/TextRing.astro';
import { projects, passionProject } from '../../data/projects';
import { withBase } from '../../lib/url';

const stack = [...new Set(projects.filter((p) => p.status === 'live').flatMap((p) => p.tags))];
---

<Base
  title="Projects"
  description="Things Holly McHugh has built: machine learning, NLP, data and more."
>
  <Section tone="dark" label="Projects board">
    <div class="board">
      <div class="title">
        <p class="hand">things I've built (some even worked first try)</p>
        <h1 class="display">Projects</h1>
      </div>
      <ul class="objects">
        {projects.map((p) => <ProjectObject project={p} />)}
      </ul>
    </div>
    <div slot="decor" class="ring-corner">
      <TextRing text="work in progress · more soon" size={240} />
    </div>
  </Section>

  {
    passionProject.enabled && (
      <Section tone="forest" label="Passion project">
        <div class="passion">
          <div>
            <p class="hand">just for fun</p>
            <h2 class="display">Passion project</h2>
            <p class="lede">{passionProject.summary}</p>
          </div>
          <div class="passion-card">
            <Polaroid
              title={passionProject.title}
              summary={passionProject.summary}
              tags={passionProject.tags}
              rot={-2}
              href={passionProject.href ? withBase(passionProject.href) : undefined}
              image={passionProject.image}
              size="lg"
            />
            <Arrow dir="tr" />
          </div>
        </div>
      </Section>
    )
  }

  {
    stack.length > 0 && (
      <Section tone="light" label="Tools used">
        <h2 class="display">Tools used</h2>
        <ul class="stack">
          {stack.map((t, i) => (
            <li class="sticker" style={`--r:${[-2, 2, -1, 3][i % 4]}deg`}>
              {t}
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</Base>

<style>
  .ring-corner {
    position: absolute;
    right: -4rem;
    bottom: -3rem;
    color: var(--accent);
  }
  .board {
    display: grid;
    gap: 2.5rem;
  }
  .title {
    text-align: center;
  }
  .title .hand {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    margin: 0;
  }
  .title h1 {
    font-size: clamp(3.5rem, 15vw, 10rem);
    margin: 0;
  }
  .objects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3rem;
    justify-items: start;
    padding-inline: 0.75rem;
  }
  .passion {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2.5rem;
    align-items: center;
  }
  .passion-card {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    max-width: 20rem;
    color: var(--accent);
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (min-width: 760px) {
    .board {
      position: relative;
      display: block;
      min-height: 62rem;
    }
    .title {
      position: absolute;
      inset: 40% 12% auto;
      transform: translateY(-50%);
      z-index: 1;
      pointer-events: none;
    }
    .objects {
      position: relative;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: repeat(9, 6.5rem);
      gap: 1rem;
      justify-items: center;
    }
  }
</style>
