---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TextRing from '../components/TextRing.astro';
import Polaroid from '../components/Polaroid.astro';
import NoteCard from '../components/NoteCard.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { note } from '../data/note';
import { experience, otherExperience, education, skills } from '../data/profile';
import { withBase } from '../lib/url';

const teaser = projects.slice(0, 3);
---

<Base>
  <Section tone="dark" label="Introduction">
    <h1 class="display">{site.name}</h1>
    <p class="hand lede-hand">{site.tagline}</p>
    <p class="lede">{site.intro}</p>
    <ul class="link-row">
      <li><a href={withBase('/projects')}>Projects</a></li>
      <li><a href={withBase('/cv')}>CV</a></li>
      <li><a href={site.links.github} rel="noopener">GitHub</a></li>
      <li><a href={site.links.linkedin} rel="noopener">LinkedIn</a></li>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
    </ul>
    <div slot="decor" class="ring-corner">
      <TextRing text="building things · learning in public" size={260} />
    </div>
  </Section>

  <Section tone="light" id="about" label="About">
    <h2 class="display">About</h2>
    <div class="prose">
      {site.about.slice(0, 2).map((p) => <p>{p}</p>)}
      <p><a class="btn" href={withBase('/about')}>More about me</a></p>
    </div>
  </Section>

  <Section tone="dark" id="projects" label="Projects">
    <h2 class="display">Projects</h2>
    <p class="hand lede-hand">things I've built (some even worked first try)</p>
    <ul class="teaser-grid">
      {
        teaser.map((p, i) => (
          <li>
            <Polaroid
              title={p.title}
              summary={p.summary}
              tags={p.tags}
              rot={[-2.5, 1.5, -1][i % 3]}
              href={p.status === 'live' ? withBase(`/projects/${p.slug}`) : undefined}
              image={p.image}
              imageAlt={p.imageAlt}
              size="sm"
            />
          </li>
        ))
      }
    </ul>
    <p><a class="btn" href={withBase('/projects')}>See the whole board</a></p>
  </Section>

  <Section tone="light" id="experience" label="Experience">
    <h2 class="display">Experience</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li>
            <p class="date">{job.date}</p>
            <div>
              <h3>{job.role}</h3>
              <p class="org">{job.org} · {job.location}</p>
              <ul>{job.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </li>
        ))
      }
    </ol>
    <details>
      <summary>Other experience</summary>
      <ol class="timeline">
        {
          otherExperience.map((job) => (
            <li>
              <p class="date">{job.date}</p>
              <div>
                <h3>{job.role}</h3>
                <p class="org">{job.org} · {job.location}</p>
                <ul>{job.points.map((pt) => <li>{pt}</li>)}</ul>
              </div>
            </li>
          ))
        }
      </ol>
    </details>
  </Section>

  <Section tone="forest" id="skills" label="Skills">
    <h2 class="display">Skills</h2>
    <div class="clusters">
      {
        skills.map((g, i) => (
          <div class="cluster" style={`--tilt:${[-1.5, 1, 1.5, -1][i % 4]}deg`}>
            <p class="hand">{g.hand}</p>
            <h3>{g.title}</h3>
            <ul>
              {g.items.map((it, j) => (
                <li class="sticker" style={`--r:${[-3, 2, -1, 3][j % 4]}deg`}>
                  {it}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="light" id="education" label="Education">
    <h2 class="display">Education</h2>
    <ol class="timeline">
      {
        education.map((e) => (
          <li>
            <p class="date">{e.date}</p>
            <div>
              <h3>{e.program}</h3>
              <p class="org">{e.school}</p>
              {e.details.length > 0 && <ul>{e.details.map((d) => <li>{d}</li>)}</ul>}
              {e.courses && (
                <details>
                  <summary>Relevant courses</summary>
                  <ul>{e.courses.map((c) => <li>{c}</li>)}</ul>
                </details>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    !note.hidden && (
      <Section tone="dark" id="note" label="Note">
        <div class="note-row">
          <h2 class="display">Note</h2>
          <NoteCard />
        </div>
      </Section>
    )
  }

  <Section tone="indigo" id="contact" label="Contact">
    <h2 class="display">Let's build something good together.</h2>
    <p class="lede">Say hi, ask about a project, or tell me about something you're working on.</p>
    <ul class="link-row">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.links.github} rel="noopener">GitHub</a></li>
      <li><a href={site.links.linkedin} rel="noopener">LinkedIn</a></li>
    </ul>
  </Section>
</Base>

<style>
  .lede-hand {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin: 0 0 1.25rem;
    max-width: 36rem;
  }
  .ring-corner {
    position: absolute;
    right: -4rem;
    top: -3rem;
    color: var(--accent);
  }
  .teaser-grid {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.25rem;
    max-width: 52rem;
  }

  .timeline {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 0.5rem 2rem;
    border-top: 2px solid var(--accent);
    padding-top: 1rem;
  }
  .date {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.15;
    color: var(--accent);
    margin: 0;
  }
  .org {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .timeline ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .timeline ul li {
    margin-bottom: 0.4rem;
  }
  details {
    margin-top: 0.75rem;
  }
  summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent);
  }
  details[open] > summary {
    margin-bottom: 1rem;
  }

  .clusters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2.5rem 2rem;
  }
  .cluster {
    transform: rotate(var(--tilt));
  }
  .cluster .hand {
    margin: 0;
    font-size: 1.5rem;
  }
  .cluster ul {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .note-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem 4rem;
  }
  .note-row .display {
    margin: 0;
  }

  @media (max-width: 640px) {
    .timeline > li {
      grid-template-columns: 1fr;
    }
    .ring-corner {
      right: -7rem;
    }
  }
</style>
