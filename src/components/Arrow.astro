---
// Hand-drawn style doodle arrow. `dir` flips it to point the way you want.
interface Props {
  dir?: 'tl' | 'tr' | 'bl' | 'br';
}

const { dir = 'br' } = Astro.props;
---

<svg
  class={`arrow ${dir}`}
  viewBox="0 0 80 60"
  width="72"
  height="54"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M5 8 C 20 50, 50 52, 72 30"></path>
  <path d="M60 28 L73 29 L68 41"></path>
</svg>

<style>
  .arrow {
    color: var(--accent);
  }
  .tl {
    transform: none;
  }
  .tr {
    transform: scaleX(-1);
  }
  .bl {
    transform: scaleY(-1);
  }
  .br {
    transform: scale(-1, -1);
  }
</style>
